# Liquid/Elements regtest read-only identity/config contract only; no adapter or execution is installed here.
# ADMIN AUTH_STORE_PATH is required to view real Liquid balances through GET /v1/operations/balances.
# Balances are read-only, filtered by LIQUID_POLICY_ASSET, and labelled Liquid test units (not BTC).
# Liquid-to-Lightning quote/swap POSTs remain 503 until an attested atomic adapter is installed.
APP_ENV=liquid-regtest
DEPLOYMENT_ID=replace-with-unique-lab-id
PORT=3400
DATA_DIR=/ABS/PATH/state/replace-with-unique-lab-id
SPEND_POLICY=disabled
LIQUID_NETWORK=elementsregtest
LIQUID_EXECUTION_ENABLED=false
ELEMENTS_RPC_URL=http://127.0.0.1:7042
ELEMENTS_COOKIE_PATH=/ABS/PATH/elements-regtest/.cookie
ELEMENTS_WALLET=replace-with-wallet
LIQUID_POLICY_ASSET=replace-with-reviewed-64-hex-policy-asset
LIQUID_PARENT_GENESIS_HASH=replace-with-reviewed-parent-genesis-hash
LIQUID_GENESIS_HASH=replace-with-reviewed-native-elements-genesis-hash
LIQUID_CONFIRMATION_POLICY=read-only
# Optional Bitcoin destination-chain attestation for npm run liquid:preflight.
# Set all three together using the existing regtest Core wallet; never create/fund one here.
# BITCOIN_RPC_URL=http://127.0.0.1:18443
# BITCOIN_COOKIE_PATH=/ABS/PATH/bitcoin-regtest/.cookie
# BITCOIN_WALLET=replace-with-wallet
# A configured Elements rail does not attest a swap provider. Execution stays disabled.
ENABLE_LIVE_SWAPS=false
REVERSE_SWAP_ENABLED=false
GUEST_SWAP_ENABLED=false
FORWARD_SWAP_ENABLED=false
REGTEST_AUTO_MINING=false

# Validated economics; defaults preserve existing quote/approval bytes.
# Nonlegacy quote policy is allowed only while native/owned execution stays closed.
QUOTE_MIN_SATS=10000
QUOTE_MAX_SATS=1000000
QUOTE_SERVICE_FEE_BASE_SATS=500
QUOTE_SERVICE_FEE_BPS=50
QUOTE_FUNDING_RESERVE_SATS=1000
QUOTE_CLAIM_FEE_SATS=500
QUOTE_TTL_SECONDS=120
INVOICE_MIN_SATS=11000
INVOICE_MAX_SATS=50000
INVOICE_SERVICE_FEE_BASE_SATS=500
INVOICE_SERVICE_FEE_DIVISOR=200
INVOICE_FUNDING_RESERVE_SATS=1000
INVOICE_CLAIM_FEE_SATS=500
INVOICE_TTL_SECONDS=120
# Protocol constants are immutable; these values are validated, not tunable.
CONFIRMATIONS_REQUIRED=1
READINESS_MAX_BLOCKS=2
READINESS_TIMEOUT_MS=90000
