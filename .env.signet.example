# Read-only signet profile. Execution and spending remain disabled.
APP_ENV=signet
DEPLOYMENT_ID=replace-with-unique-lab-id
SPEND_POLICY=disabled
SIGNET_CHALLENGE=replace-with-reviewed-default-signet-challenge
BITCOIN_RPC_URL=http://127.0.0.1:38332
BITCOIN_COOKIE_PATH=/ABS/PATH/bitcoin-signet/.cookie
BITCOIN_WALLET=replace-with-wallet
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT_PATH=/ABS/PATH/lnd-signet/tls.cert
LND_MACAROON_PATH=/ABS/PATH/lnd-signet/readonly.macaroon
ENABLE_LIVE_SWAPS=false
