# Read-only signet profile. Execution and spending remain disabled.\nAPP_ENV=signet\nDEPLOYMENT_ID=replace-with-unique-lab-id\nSPEND_POLICY=disabled\nSIGNET_CHALLENGE=replace-with-reviewed-default-signet-challenge\nBITCOIN_RPC_URL=http://127.0.0.1:38332\nBITCOIN_COOKIE_PATH=/ABS/PATH/bitcoin-signet/.cookie\nBITCOIN_WALLET=replace-with-wallet\nLND_REST_URL=https://127.0.0.1:8080\nLND_TLS_CERT_PATH=/ABS/PATH/lnd-signet/tls.cert\nLND_MACAROON_PATH=/ABS/PATH/lnd-signet/readonly.macaroon\nENABLE_LIVE_SWAPS=false\n