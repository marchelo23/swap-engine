{
  "name": "lqwd-swap-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:web",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx --test --test-name-pattern=OFFLINE tests/coordinator.test.ts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "start": "node --import tsx --import ./scripts/load-local-env.mjs src/main.ts",
    "inspect": "tsx scripts/inspect.ts",
    "verify:readonly": "tsx scripts/verify-readonly.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "build:web": "node src/web/build.mjs",
    "prestart": "npm run build:web",
    "pretest": "npm run build:web",
    "test:web": "npm run build:web && tsx --test tests/browser/*.test.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "3.2.0",
    "bitcoinjs-lib": "7.0.5",
    "ecpair": "3.0.2",
    "qrcode": "1.5.4",
    "tiny-secp256k1": "2.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "playwright": "1.65.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
