# Read-only mainnet profile. There is no mainnet signing, mining or execution path.
APP_ENV=mainnet
DEPLOYMENT_ID=replace-with-unique-lab-id
SPEND_POLICY=disabled
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_COOKIE_PATH=/ABS/PATH/bitcoin-mainnet/.cookie
BITCOIN_WALLET=replace-with-wallet
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT_PATH=/ABS/PATH/lnd-mainnet/tls.cert
LND_MACAROON_PATH=/ABS/PATH/lnd-mainnet/readonly.macaroon
ENABLE_LIVE_SWAPS=false
