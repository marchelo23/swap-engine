# Paths only; never put cookie or macaroon contents here.
# Install as ~/.config/lqwd-regtest-miner.env with mode 600.
# This miner is exclusively for the existing Bitcoin regtest chain.
BITCOIN_CLI=/usr/local/bin/bitcoin-cli
BITCOIN_DATADIR=/home/truja/.bitcoin
BITCOIN_WALLET=lqwd-lab
MINER_DATA_DIR=/home/truja/.local/share/lqwd-regtest-miner
MINER_LOCK_FILE=/home/truja/.local/share/lqwd-regtest-miner/miner.lock
