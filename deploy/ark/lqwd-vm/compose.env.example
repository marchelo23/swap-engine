# Copy this file to an untracked location outside the repository, for example
#   %TEMP%\ark-lqwd-vm\compose.env
# and restrict it to your user. Never commit the real file or its credentials.
#
# The SSH key must be a dedicated key whose VM authorized_keys entry is:
#   restrict,port-forwarding,permitopen="127.0.0.1:<gateway-port>",permitopen="127.0.0.1:<p2p-port>",command="/bin/false" ssh-ed25519 ...
# With the default ports that is 18446 and 18444. The key can only open the two
# loopback forwards and cannot run a shell.

# Required: VM destination and private key paths.
ARK_LQWD_VM_SSH_TARGET=<vm-user>@<vm-host>
ARK_LQWD_VM_KEY_PATH=<absolute-path-to-private-key>
ARK_LQWD_VM_KNOWN_HOSTS_PATH=<absolute-path-to-known-hosts>

# Required: independent lab-only random values.
# Generate each 64-character value independently; do not reuse them.
ARK_LQWD_GATEWAY_USER=<gateway-user>
ARK_LQWD_GATEWAY_PASSWORD=<64-lowercase-hex>
ARK_LQWD_WALLET_PASSWORD=<64-lowercase-hex>
ARK_LQWD_SIGNER_KEY=<64-lowercase-hex>

# Optional: VM-side gateway and P2P destinations. Defaults shown.
# ARK_LQWD_VM_GATEWAY_HOST=127.0.0.1
# ARK_LQWD_VM_GATEWAY_PORT=18446
# ARK_LQWD_VM_P2P_HOST=127.0.0.1
# ARK_LQWD_VM_P2P_PORT=18444

# Optional: tunnel listen address inside the container and healthcheck host.
# Defaults shown.
# ARK_LQWD_TUNNEL_LISTEN_HOST=0.0.0.0
# ARK_LQWD_TUNNEL_RPC_PORT=18443
# ARK_LQWD_TUNNEL_P2P_PORT=18444
# ARK_LQWD_TUNNEL_HEALTHCHECK_HOST=127.0.0.1
# ARK_LQWD_TUNNEL_USER=1000:1000
# ARK_LQWD_SSH_ALIVE_INTERVAL=15
# ARK_LQWD_SSH_ALIVE_COUNT=3

# Optional: host bind address and published ports. Defaults shown.
# ARK_LQWD_HOST_BIND=127.0.0.1
# ARK_LQWD_ARKD_PORT=37170
# ARK_LQWD_ARKD_ADMIN_PORT=37171
# ARK_LQWD_MEMPOOL_PORT=33100
# ARK_LQWD_NBXPLORER_PORT=32938

# Optional: internal service hosts and ports. Defaults shown.
# ARK_LQWD_BITCOIN_NETWORK=regtest
# ARK_LQWD_TUNNEL_HOST=tunnel
# ARK_LQWD_POSTGRES_HOST=postgres
# ARK_LQWD_POSTGRES_PORT=5432
# ARK_LQWD_POSTGRES_USER=postgres
# ARK_LQWD_POSTGRES_DB=postgres
# ARK_LQWD_POSTGRES_PROJECTION_DB=projection
# ARK_LQWD_POSTGRES_EVENT_DB=event
# ARK_LQWD_POSTGRES_SSLMODE=disable
# ARK_LQWD_POSTGRES_AUTOCREATE=true
# ARK_LQWD_POSTGRES_AUTH_METHOD=trust
# ARK_LQWD_NBXPLORER_HOST=nbxplorer
# ARK_LQWD_NBXPLORER_INTERNAL_PORT=32838
# ARK_LQWD_NBXPLORER_DB=nbxplorer
# ARK_LQWD_NBXPLORER_CHAINS=btc
# ARK_LQWD_NBXPLORER_DATADIR=/datadir
# ARK_LQWD_NBXPLORER_NOAUTH=1
# ARK_LQWD_FULCRUM_HOST=fulcrum
# ARK_LQWD_FULCRUM_PORT=50001
# ARK_LQWD_MEMPOOL_HOST=mempool_api
# ARK_LQWD_MEMPOOL_INTERNAL_PORT=8999
# ARK_LQWD_MEMPOOL_API_PREFIX=/api/
# ARK_LQWD_MEMPOOL_USER=1000:1000
# ARK_LQWD_MEMPOOL_BACKEND=electrum
# ARK_LQWD_MEMPOOL_NETWORK=regtest
# ARK_LQWD_MEMPOOL_DATABASE_ENABLED=false
# ARK_LQWD_MEMPOOL_CACHE_DIR=/backend/cache
# ARK_LQWD_MEMPOOL_POLL_RATE_MS=2000
# ARK_LQWD_MEMPOOL_EXTERNAL_MAX_RETRY=0
# ARK_LQWD_MEMPOOL_STATISTICS=false
# ARK_LQWD_MEMPOOL_LIGHTNING=false
# ARK_LQWD_MEMPOOL_WAIT_TIMEOUT=180
# ARK_LQWD_ELECTRUM_TLS=false
# ARK_LQWD_ARKD_WALLET_HOST=arkd-wallet
# ARK_LQWD_ARKD_WALLET_PORT=6060
# ARK_LQWD_ARKD_SIGNER_HOST=arkd-signer
# ARK_LQWD_ARKD_SIGNER_PORT=6061
# ARK_LQWD_REDIS_HOST=redis
# ARK_LQWD_REDIS_PORT=6379
# ARK_LQWD_REDIS_DB=0

# Optional: arkd tuning. Defaults shown. These are lab settings, not
# production values.
# ARK_LQWD_ARKD_NO_TLS=true
# ARK_LQWD_ARKD_NO_MACAROONS=true
# ARK_LQWD_ARKD_ESPLORA_PATH=/api
# ARK_LQWD_ARKD_DB_TYPE=postgres
# ARK_LQWD_ARKD_EVENT_DB_TYPE=postgres
# ARK_LQWD_ARKD_LIVE_STORE_TYPE=redis
# ARK_LQWD_ARKD_UNLOCKER_TYPE=env
# ARK_LQWD_ARKD_SCHEDULER_TYPE=block
# ARK_LQWD_ARKD_VTXO_MIN_AMOUNT=1
# ARK_LQWD_ARKD_ROUND_MIN_PARTICIPANTS_COUNT=1
# ARK_LQWD_ARKD_SESSION_DURATION=10
# ARK_LQWD_ARKD_UNILATERAL_EXIT_DELAY=20
# ARK_LQWD_ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=20
# ARK_LQWD_ARKD_BOARDING_EXIT_DELAY=30
# ARK_LQWD_ARKD_CHECKPOINT_EXIT_DELAY=10
# ARK_LQWD_ARKD_VTXO_TREE_EXPIRY=40
# ARK_LQWD_ARKD_UNROLLED_VTXO_MIN_EXPIRY_MARGIN=10

# Optional: project, label, network, volume, container and image names.
# Defaults shown.
# ARK_LQWD_PROJECT_NAME=swap-engine-ark-lqwd-vm
# ARK_LQWD_LABEL=lqwd-vm
# ARK_LQWD_NETWORK=swap_engine_ark_lqwd_net
# ARK_LQWD_HOST_NETWORK=swap_engine_ark_lqwd_host_net
# ARK_LQWD_POSTGRES_VOLUME=swap_engine_ark_lqwd_postgres_data
# ARK_LQWD_NBXPLORER_VOLUME=swap_engine_ark_lqwd_nbxplorer_data
# ARK_LQWD_FULCRUM_VOLUME=swap_engine_ark_lqwd_fulcrum_data
# ARK_LQWD_MEMPOOL_VOLUME=swap_engine_ark_lqwd_mempool_cache
# ARK_LQWD_WALLET_VOLUME=swap_engine_ark_lqwd_wallet_data
# ARK_LQWD_ARKD_VOLUME=swap_engine_ark_lqwd_arkd_data
# ARK_LQWD_TUNNEL_CONTAINER=ark_lqwd_tunnel
# ARK_LQWD_POSTGRES_CONTAINER=ark_lqwd_postgres
# ARK_LQWD_REDIS_CONTAINER=ark_lqwd_redis
# ARK_LQWD_NBXPLORER_CONTAINER=ark_lqwd_nbxplorer
# ARK_LQWD_FULCRUM_CONTAINER=ark_lqwd_fulcrum
# ARK_LQWD_MEMPOOL_CONTAINER=ark_lqwd_mempool_api
# ARK_LQWD_ARKD_WALLET_CONTAINER=ark_lqwd_arkd_wallet
# ARK_LQWD_ARKD_SIGNER_CONTAINER=ark_lqwd_arkd_signer
# ARK_LQWD_ARKD_CONTAINER=ark_lqwd_arkd
# ARK_LQWD_TUNNEL_IMAGE=swap-engine-ark-lqwd-vm-tunnel:local
# ARK_LQWD_POSTGRES_IMAGE=docker.io/library/postgres:16
# ARK_LQWD_REDIS_IMAGE=docker.io/library/redis:7-alpine
# ARK_LQWD_NBXPLORER_IMAGE=docker.io/nicolasdorier/nbxplorer:2.6.7
# ARK_LQWD_FULCRUM_IMAGE=docker.io/cculianu/fulcrum:v2.1.1
# ARK_LQWD_MEMPOOL_IMAGE=docker.io/mempool/backend:v3.3.1
# ARK_LQWD_ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.25
# ARK_LQWD_ARKD_SIGNER_IMAGE=ghcr.io/arkade-os/arkd-signer:v0.9.25
# ARK_LQWD_ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.25
