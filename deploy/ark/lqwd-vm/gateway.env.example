# Copy this file to the VM outside the repository, for example
#   ~/ark-lqwd-vm/gateway.env
# and restrict it to the VM user. The gateway reads the Core cookie itself and
# requires inbound Basic auth; the credentials are lab-only, not Core
# credentials. Use the same values as ARK_LQWD_GATEWAY_USER and
# ARK_LQWD_GATEWAY_PASSWORD in compose.env.
#
# Use "minimal" for the backend's read-only checks. Use "indexer-readonly"
# only for the Ark indexers, and only with explicit approval.

ARK_GATEWAY_PROFILE=<minimal|indexer-readonly>
ARK_GATEWAY_LISTEN_HOST=127.0.0.1
ARK_GATEWAY_LISTEN_PORT=<gateway-port>
ARK_GATEWAY_UPSTREAM_HOST=127.0.0.1
ARK_GATEWAY_UPSTREAM_PORT=<core-rpc-port>
ARK_GATEWAY_COOKIE=<absolute-path-to-core-cookie>

# Required: real inbound Basic auth. Both listen and upstream hosts must be
# 127.0.0.1.
ARK_GATEWAY_AUTH_USER=<gateway-user>
ARK_GATEWAY_AUTH_PASSWORD=<gateway-password>

# Optional: defensive limits. Defaults shown.
# ARK_GATEWAY_MAX_BODY=65536
# ARK_GATEWAY_MAX_RESPONSE=8388608
# ARK_GATEWAY_UPSTREAM_TIMEOUT_MS=15000
