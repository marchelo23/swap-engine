# Isolated Regtest Stack template for Podman Compose.
# Copy or generate the real file at:
#   $ISO_RT_RUNTIME_DIR/compose.env (default ~/.local/share/swap-engine-iso-regtest, mode 0600)
# Never commit real credentials, keys, cookies, or macaroons to git.

ISO_RT_PROJECT_NAME=swap-engine-iso-regtest
# Absolute path outside the repo (required by docker-compose.yml)
ISO_RT_RUNTIME_DIR=/ABS/PATH/swap-engine-iso-regtest
ISO_RT_HOST_BIND=127.0.0.1

# Independent random credentials generated by deploy/isolated-regtest/bootstrap.mjs
ISO_RT_BITCOIN_RPC_USER=iso-rt-rpc
ISO_RT_BITCOIN_RPC_PASS=replace-with-random-hex
ISO_RT_BITCOIN_RPCAUTH=replace-with-rpcauth-entry
ISO_RT_ARKD_WALLET_PASS=replace-with-random-hex
ISO_RT_ARKD_SIGNER_KEY=replace-with-random-hex

# Host loopback ports (all bound to 127.0.0.1, disjoint from existing lab ports)
ISO_RT_BITCOIN_RPC_PORT=48443
ISO_RT_BITCOIN_P2P_PORT=48444
ISO_RT_BITCOIN_ZMQ_BLOCK_PORT=48332
ISO_RT_BITCOIN_ZMQ_TX_PORT=48333

ISO_RT_LND_PROVIDER_REST_PORT=48080
ISO_RT_LND_PROVIDER_GRPC_PORT=40009
ISO_RT_LND_PROVIDER_P2P_PORT=49735

ISO_RT_LND_ALICE_REST_PORT=48081
ISO_RT_LND_ALICE_GRPC_PORT=40010
ISO_RT_LND_ALICE_P2P_PORT=49736

ISO_RT_NBXPLORER_PORT=42938
ISO_RT_MEMPOOL_PORT=43100
ISO_RT_ARKD_PORT=47070
ISO_RT_ARKD_ADMIN_PORT=47071
ISO_RT_ELEMENTS_RPC_PORT=47052
