[Unit]
# Install as a systemd --user unit; do not enable or start during verification.
Description=Swap Engine isolated regtest review candidate
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/swap-engine
EnvironmentFile=%h/.config/swap-engine/review.env
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/swap-engine-review
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
