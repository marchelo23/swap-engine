# Review candidate only: separate listener/data; never overwrite an existing env file.
APP_ENV=regtest
DEPLOYMENT_ID=replace-with-unique-lab-id
SPEND_POLICY=disabled
ENABLE_LIVE_SWAPS=false
PORT=3100
DATA_DIR=/ABS/PATH/review-data
AUTH_ORIGIN=http://127.0.0.1:3100
# Existing server-side account file: set the actual path after review; do not copy passwords.
AUTH_STORE_PATH=/ABS/EXISTING/users.json
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_COOKIE_PATH=/ABS/PATH/bitcoin-regtest/.cookie
BITCOIN_WALLET=replace-with-wallet
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT_PATH=/ABS/PATH/lnd/tls.cert
LND_MACAROON_PATH=/ABS/PATH/lnd/readonly.macaroon
# Set the three existing read-only Alice paths together only if Operations needs them.
# No vault passphrase, payment macaroon, approval token or JIT flags belong in this file.
