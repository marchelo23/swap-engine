[Unit]
# Install as a systemd --user unit; do not enable or start during verification.
Description=Swap Engine regtest simulation and read-only diagnostics
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/swap-engine
EnvironmentFile=%h/.config/swap-engine/regtest.env
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/swap-engine
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
