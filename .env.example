# Run inside the existing Ubuntu VM. Paths point to local files; never paste credentials here.
# Regtest read-only example, matching deploy/regtest.env.example.
# For offline simulation use deploy/simulation.env.example instead.
APP_MODE=regtest
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_COOKIE_PATH=/home/truja/.bitcoin/regtest/.cookie
BITCOIN_WALLET=lqwd-lab
# LND REST must already be enabled locally. gRPC port 10009 is NOT the REST port.
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT_PATH=/home/truja/.lnd/tls.cert
LND_MACAROON_PATH=/home/truja/.lnd/data/chain/bitcoin/regtest/readonly.macaroon
# Optional Alice LND source for operations balances. Set all three to enable.
# ALICE_LND_REST_URL=https://127.0.0.1:8081
# ALICE_LND_TLS_CERT_PATH=/path/to/alice/tls.cert
# ALICE_LND_MACAROON_PATH=/path/to/alice/readonly.macaroon
DATA_DIR=./data
PORT=3000
# Safe default: API and protocol components only; funding orchestration is intentionally gated.
ENABLE_LIVE_SWAPS=false
# Optional existing-payment evidence reconciliation only; never enables execution.
ENABLE_READ_ONLY_RECOVERY=false
# Required together when enabled: independently verify and pin both public node IDs.
# RECOVERY_PROVIDER_NODE_PUBKEY=
# RECOVERY_PAYER_NODE_PUBKEY=
# RECOVERY_PAYER_REST_URL=https://127.0.0.1:8081
# RECOVERY_PAYER_TLS_CERT_PATH=/path/to/existing/payer/tls.cert
# RECOVERY_PAYER_MACAROON_PATH=/path/to/existing/payer/readonly.macaroon
